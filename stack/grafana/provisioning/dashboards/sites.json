{
  "uid": "site-deployer-sites",
  "title": "Sites",
  "tags": ["site-deployer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_memory_working_set_bytes{site!=\"\"}, site)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "scope",
        "label": "Probe scope",
        "type": "custom",
        "query": "internal,public",
        "current": { "text": "internal", "value": "internal" },
        "options": [
          { "text": "internal", "value": "internal", "selected": true },
          { "text": "public", "value": "public", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability",
      "description": "Fraction of probes that succeeded over the selected range.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value" },
      "targets": [
        {
          "expr": "avg by (site) (avg_over_time(probe_success{site=~\"$site\", scope=\"$scope\"}[$__rate_interval]))",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response time",
      "description": "Blackbox probe duration. Origin latency only - it does not include the Cloudflare edge.",
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{site=~\"$site\", scope=\"$scope\"}",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU",
      "description": "Cores used per site container.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum by (site) (rate(container_cpu_usage_seconds_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory",
      "description": "Working set, which is what the OOM killer looks at.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum by (site) (container_memory_working_set_bytes{site=~\"$site\"})",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Bytes in and out of each site container. This is the closest stand-in for per-site traffic volume; without a proxy in front there are no HTTP request counts.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum by (site) (rate(container_network_receive_bytes_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{site}} in"
        },
        {
          "expr": "-sum by (site) (rate(container_network_transmit_bytes_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{site}} out"
        }
      ]
    }
  ]
}
