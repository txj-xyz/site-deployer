# --- server ---
PORT=8080
HOST=0.0.0.0

# --- storage ---
# SQLite db + cloned repos live here
DATA_DIR=./data

# --- docker ---
# Shared network that managed site containers join.
# Phase 2: cloudflared joins this network and addresses sites by container name.
DOCKER_NETWORK=site-deployer
IMAGE_PREFIX=sitedeployer
# Host ports are allocated per deployment from this range, bound to 127.0.0.1 only.
HOST_PORT_MIN=40000
HOST_PORT_MAX=49999
# Images kept per site for rollback (older ones are pruned after a successful deploy)
KEEP_IMAGES_PER_SITE=3

# --- health checks ---
HEALTH_TIMEOUT_MS=60000
HEALTH_INTERVAL_MS=1000

# --- git polling ---
# How often each git-backed site is checked for new commits. 0 disables polling.
# Checks use `git ls-remote`, which transfers no objects, so this is cheap.
# Repeated failures back this off per site, up to 32x.
GIT_POLL_INTERVAL_MS=60000
GIT_POLL_CONCURRENCY=3

# --- cloudflare ---
# Leave these blank to run in plan-only mode: deploys work end to end and every
# Cloudflare call is logged instead of sent. Fill all five to go live.
# Token needs Zone:DNS:Edit on the zone and Account:Cloudflare Tunnel:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
BASE_DOMAIN=

# Tunnel token for stack/compose.yaml (cloudflared itself). Different from the
# API token above: Zero Trust -> Networks -> Tunnels -> Configure.
CLOUDFLARE_TUNNEL_TOKEN=

# How an ingress rule addresses a site:
#   container - http://<container-name>:<containerPort>  (cloudflared must join DOCKER_NETWORK)
#   hostport  - http://<TUNNEL_ORIGIN_HOST>:<hostPort>
ORIGIN_MODE=container
TUNNEL_ORIGIN_HOST=host.docker.internal

# --- remote docker (local development against your server) ---
# The deployer normally runs ON the docker host, so ports bind to loopback and
# health checks dial 127.0.0.1. When driving a remote docker daemon from your
# laptop, point DOCKER_HOST at it and widen the publish/probe hosts:
#   DOCKER_HOST=ssh://user@server
#   PUBLISH_HOST_IP=0.0.0.0
#   PROBE_HOST=server.lan
# PUBLISH_HOST_IP=0.0.0.0 exposes site ports on your LAN - revert both to
# 127.0.0.1 once the deployer runs on the server itself.

# --- metrics ---
# Prometheus scrapes the deployer (per-container CPU/memory/network) and blackbox
# (per-site availability and response time). Grafana is provisioned with a
# dashboard for both. Bring the stack up with:
#   docker compose -f stack/compose.yaml --env-file .env up -d
PROMETHEUS_URL=http://localhost:9090
# Written by the deployer, mounted read-only into Prometheus. Use an ABSOLUTE
# path: this one variable is read by two things with different base directories
# - the deployer resolves it from the repo root, while Compose resolves bind
# mounts from stack/. A relative path therefore points the writer and the reader
# at two different directories, and the site-probes job silently finds no
# targets.
PROMETHEUS_TARGETS_DIR=/absolute/path/to/site-deployer/data/prometheus-targets
# Per-container CPU/memory/network is exported by the deployer itself, from the
# Docker API, on an unauthenticated /metrics endpoint that Prometheus scrapes at
# host.docker.internal:$PORT. This replaced cAdvisor, which cannot collect
# anything against Docker Desktop's overlayfs storage driver. If you change PORT,
# change the site-containers target in stack/prometheus/prometheus.yml to match.
TARGETS_REFRESH_MS=15000
METRICS_RETENTION=30d
GRAFANA_PASSWORD=admin

# --- security ---
# Encryption key for site env values, 32 bytes as 64 hex chars or base64.
# Leave blank and one is generated at data/secret.key on first run.
# Back it up: losing it makes every stored env value unreadable.
#   openssl rand -base64 32
SECRET_KEY=

# Pick ONE of the two below. With neither, the API is unauthenticated and the
# service must not be exposed.
#
# 1. Cloudflare Access (recommended - it challenges at the edge, before requests
#    reach this process). Put an Access application in front of the dashboard
#    hostname, then copy its Audience tag here.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
#
# 2. A shared token, for a dashboard that stays on the LAN.
#    The UI prompts for it and stores it in an HttpOnly cookie.
DASHBOARD_TOKEN=

# --- reconciler ---
# How often desired state is compared with Docker and Cloudflare. 0 disables.
RECONCILE_INTERVAL_MS=120000
# Whether the reconciler may delete tunnel ingress rules under BASE_DOMAIN that
# no site claims. Off by default - they may belong to something else you run
# through the same tunnel.
RECONCILE_PRUNE_INGRESS=false
